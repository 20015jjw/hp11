[Unit]
Description=hp11 Dyson controller
After=network-online.target
Wants=network-online.target

[Service]
User=hp11
WorkingDirectory=/opt/hp11
EnvironmentFile=/opt/hp11/.env
Environment=HP11_DATA=/var/lib/hp11
StateDirectory=hp11
ExecStart=/opt/hp11/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8011
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
